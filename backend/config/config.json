{
    "urlBase": "http://localhost:5173",
    "frontendUrl": "http://localhost:5173",
    "database": {
        "UP": {
            "name": "UP",
            "host": "${DB_HOST:localhost}",
            "username": "${DB_USER:root}",
            "password": "${DB_PASSWORD:}",
            "database": "UP",
            "charset": "utf8mb4"
        }
    },
    "firstController": "indexController@index",
    "session": {
        "lifetime": 2592000,
        "secure": false,
        "httponly": true,
        "samesite": "Lax"
    },
    "security": {
        "rateLimit": {
            "enabled": true,
            "maxAttempts": 5,
            "windowMs": 900000
        }
    }
}
